# ---------------------------------------------------------------------------
# budget_app — .gitignore
# ---------------------------------------------------------------------------

# 이 프로젝트가 실행 중 만들어내는 산출물 (코드가 아니므로 커밋하지 않음)
#
# 주의: .gitignore 에서 '#' 은 **줄 맨 앞에서만** 주석이다.
# 'data/   # 설명' 처럼 패턴 뒤에 붙이면 설명까지 패턴의 일부가 되어
# 아무 파일도 무시되지 않는다. 그래서 설명은 패턴 위쪽 줄에 적는다.

# 기본 저장 폴더 (transactions/categories/budgets/recurring.jsonl, app.log)
data/
# demo.sh 가 사용하는 시연용 저장 폴더
demo_data/
# demo.sh 의 --data-dir 분리 시연용 폴더
demo_data_other/
# 백업 파일 폴더
backups/
# JSONL 저장 파일
*.jsonl
# backup 명령이 만든 타임스탬프 사본
*.bak
# 실행 로그(app.log 등)
*.log
# 원자적 교체(os.replace) 도중 남은 임시 파일
.tmp_*
# export 결과
export*.csv
# import 시연용 입력
import*.csv
# demo.sh 가 만드는 CSV
demo_*.csv
# 시연할 때 손으로 입력할 명령어 치트시트 (개인용 메모)
DEMO_COMMANDS.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 가상환경
.venv/
venv/
env/
ENV/
.python-version

# 테스트 / 정적 분석 캐시
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# 에디터 / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
